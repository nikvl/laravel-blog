{
    "name": "nikv/blog",
    "description": "Laravel blog package with Inertia/React frontend",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11|^12",
        "league/commonmark": "^2",
        "inertiajs/inertia-laravel": "^2|^3",
        "beyondcode/laravel-comments": "^1.9",
        "spatie/laravel-tags": "^4.12"
    },
    "suggest": {
        "artesaos/seotools": "Required when blog.seo = 'artesaos'"
    },
    "autoload": {
        "psr-4": {
            "Nikv\\Blog\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nikv\\Blog\\BlogServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
