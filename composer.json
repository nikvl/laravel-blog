{
    "name": "nikv/blog",
    "description": "Laravel blog package with Inertia/React frontend",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11|^12",
        "league/commonmark": "^2",
        "inertiajs/inertia-laravel": "^2"
    },
    "suggest": {
        "spatie/laravel-tags": "Required when config('blog.tags') = 'spatie-tags'",
        "beyondcode/laravel-comments": "Required when config('blog.comments') = 'beyondcode'",
        "artesaos/seotools": "Required when config('blog.seo') = 'artesaos'"
    },
    "autoload": {
        "psr-4": {
            "Nikv\\Blog\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nikv\\Blog\\BlogServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
